# Local development inputs, not B2B host configuration.
HOST=0.0.0.0
PORT=3000
NEXT_PUBLIC_CHAIN_ID=31338
NEXT_PUBLIC_CORE_DIAMOND_ADDRESS=0x0000000000000000000000000000000000000001
NEXT_PUBLIC_RPC_URL=http://host.docker.internal:8545
RPC_URL=http://host.docker.internal:8545
# Configure your actual local deployment addresses for working contract flows.
# DATABASE_URL is optional for the API; supply your own PostgreSQL database
# when using persisted projections or running cybergold_candidate.worker_main.

# Optional Backend-owned Sandbox funding. Ops supplies private RPC capability,
# persistent state and the Anvil generation directory for a hosted deployment.
FORK_FAUCET_ENABLED=0
FORK_FAUCET_RPC_URL=
FORK_FAUCET_RPC_AUTHORIZATION=
FORK_FAUCET_STATE_ROOT=
FORK_FAUCET_GENERATION_FILE=
