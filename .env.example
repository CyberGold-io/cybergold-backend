HOST=127.0.0.1
PORT=3001
NEXT_PUBLIC_CHAIN_ID=31338
# Deployment roots belong to the Backend. The App reads /api/protocol/config.
# CYGLD is the configured Core diamond; it has no separate address setting.
NEXT_PUBLIC_CORE_DIAMOND_ADDRESS=0x0000000000000000000000000000000000000001
# Optional deployment roots; leave unavailable contracts empty.
NEXT_PUBLIC_HELPERS_DIAMOND_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_DIAMOND_ADDRESS=
NEXT_PUBLIC_STAKING_DIAMOND_ADDRESS=
# Configured product Safe, distinct from the Helpers' current owner.
NEXT_PUBLIC_GOVERNANCE_SAFE_ADDRESS=
# No adapter preference setting: the Backend selects its supported encoding
# from the cached canonical Helpers approval set.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:9545
RPC_URL=http://127.0.0.1:9545
# DATABASE_URL and private broker/worker credentials are supplied by Ops.

# Optional Backend-owned Sandbox funding. Ops supplies private RPC capability,
# persistent state and the Anvil generation directory for a hosted deployment.
FORK_FAUCET_ENABLED=0
FORK_FAUCET_RPC_URL=
FORK_FAUCET_RPC_AUTHORIZATION=
FORK_FAUCET_STATE_ROOT=
FORK_FAUCET_GENERATION_FILE=
